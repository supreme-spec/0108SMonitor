// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Camera {
  id                   Int       @id @default(autoincrement())
  name                 String
  source               String
  camera_type          String    @default("USB") // USB, ONVIF, RTSP, Hikvision, UNV
  zone                 String?
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now())
  status               String    @default("offline")
  roi_zones            String?   // JSON string
  fps                  Int       @default(25)
  ping_ms              Int       @default(0)
  is_smart_recording   Boolean   @default(false)
  is_chronicle         Boolean   @default(true)
  driver_type          String?
  ip_address           String?
  ip_port              Int?
  username             String?
  password             String?
  use_camera_analytics Boolean   @default(false)
  
  events               Event[]
  recordings           Recording[]
}

model Category {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  label          String
  color          String
  bg_color       String
  is_alert       Boolean   @default(false)
  alert_sound    String    @default("off")
  alert_volume   Float     @default(0.5)
  detect_enabled Boolean   @default(true)
  sort_order     Int       @default(100)
  is_system      Boolean   @default(false)
}

model Person {
  id              Int               @id @default(autoincrement())
  name            String
  category        String
  position        String?
  comment         String?
  phone           String?
  email           String?
  birth_date      String?
  address         String?
  organization    String?
  extra_info      String?
  photo_path      String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now())
  last_seen_at    DateTime?
  visit_count     Int               @default(0)
  embedding_count Int               @default(0)
  
  photos          PersonPhoto[]
  confirmations   FaceConfirmation[]
  events          Event[]
  incidents       Incident[]
  tags            Tag[]
  descriptors     FaceDescriptor[]
  policies        PersonPolicy[]
  episode_persons EpisodePerson[]
}

model FaceDescriptor {
  id          Int       @id @default(autoincrement())
  person_id   Int
  photo_path  String
  descriptor  String    // JSON array of floats
  created_at  DateTime  @default(now())
  
  person      Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)
  
  @@index([person_id])
}

model PersonPhoto {
  id            Int      @id @default(autoincrement())
  person_id     Int
  photo_path    String
  is_primary    Boolean  @default(false)
  has_embedding Boolean  @default(false)
  source        String   @default("manual") // manual | confirmation | auto
  confidence    Float?
  created_at    DateTime @default(now())

  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([person_id])
  @@map("person_photos")
}

model FaceConfirmation {
  id                  Int       @id @default(autoincrement())
  person_id           Int
  confidence          Float
  temp_photo_path     String
  existing_photo_path String?
  person_name         String?
  category            String?
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED
  created_at          DateTime  @default(now())
  confirmed_at        DateTime?
  confirmed_by        String?
  rejected_reason     String?

  person              Person    @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([person_id])
  @@map("face_confirmations")
}

model Event {
  id                          Int       @id @default(autoincrement())
  camera_id                   Int
  camera_name                 String
  person_id                   Int?
  event_type                  String
  confidence                  Float
  snapshot_path               String?
  person_name                 String?
  person_category             String?
  person_photo_path           String?
  created_at                  DateTime  @default(now())
  needs_operator_confirmation Boolean   @default(false)
  confirmation_status         String?
  confirmation_id             Int?      // links to face_confirmations.id when this event was created from an operator-confirmation request

  camera                      Camera    @relation(fields: [camera_id], references: [id], onDelete: Cascade)
  person                      Person?   @relation(fields: [person_id], references: [id], onDelete: SetNull)

  @@index([camera_id])
  @@index([person_id])
  @@index([created_at])
  @@index([confirmation_id])
}

model Recording {
  id          Int      @id @default(autoincrement())
  camera_id   Int
  camera_name String
  start_time  DateTime
  end_time    DateTime
  duration    Int
  size_mb     Float
  video_path  String
  is_favorite Boolean  @default(false)
  
  camera      Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)
}

model Incident {
  id            Int      @id @default(autoincrement())
  person_id     Int
  incident_type String
  severity      String
  comment       String?
  status        String   @default("open")
  created_at    DateTime @default(now())
  
  person        Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model Tag {
  id        Int    @id @default(autoincrement())
  person_id Int
  tag       String
  
  person    Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

// ============================================
// ARCHIVE & BATCH PROCESSING MODELS
// ============================================

/// Контекстные роли персоны (зона/время/тип эпизода)
model PersonPolicy {
  id              Int        @id @default(autoincrement())
  person_id       Int
  zone_id         Int?
  zone_name       String?
  schedule_type   String     @default("default") // default | night | weekend | custom
  start_time      String?    // HH:MM format
  end_time        String?    // HH:MM format
  role            String     @default("unknown") // target | ignore | noise | svita | unknown
  confidence      Float      @default(0.5) // 0.0-1.0, low_confidence = operator review needed
  label_source    String     @default("operator") // operator | propagated | auto
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now())
  comment         String?
  
  person          Person     @relation(fields: [person_id], references: [id], onDelete: Cascade)
  
  @@index([person_id])
  @@index([zone_id])
  @@index([role])
}

/// Эпизод (папка с фото/видео)
model Episode {
  id              Int        @id @default(autoincrement())
  folder_path     String     @unique
  episode_name    String
  source_type     String     @default("camera") // camera | enrollment | archive | screen_photo
  capture_time    DateTime?
  camera_id       Int?
  camera_name     String?
  total_photos    Int        @default(0)
  processed_at    DateTime?
  status          String     @default("pending") // pending | processing | completed | failed
  error_message   String?
  created_at      DateTime   @default(now())
  
  persons         EpisodePerson[]
  photos          ArchivePhoto[]
  clusters        FaceCluster[]
  clustering_logs ClusteringLog[]
  
  @@index([folder_path])
  @@index([status])
}

/// Связь между эпизодом и персоной (контекстная роль в этом эпизоде)
model EpisodePerson {
  id              Int        @id @default(autoincrement())
  episode_id      Int
  person_id       Int?
  person_name     String?    // для неопознанных лиц
  role            String     @default("unknown") // target | ignore | noise | svita | unknown
  confidence      Float      @default(0.5)
  label_source    String     @default("operator") // operator | propagated | auto
  cluster_id      String?    // ID кластера внутри эпизода
  is_merge_hint   Boolean    @default(false) // подсказка оператору: возможно один человек
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now())
  
  episode         Episode    @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  person          Person?    @relation(fields: [person_id], references: [id], onDelete: SetNull)
  
  faces           ArchiveFace[]
  
  @@index([episode_id])
  @@index([person_id])
  @@index([role])
}

/// Архивное фото (оригинальное изображение из архива)
model ArchivePhoto {
  id              Int        @id @default(autoincrement())
  episode_id      Int
  photo_path      String
  filename        String
  width           Int?
  height          Int?
  source_width    Int?       // оригинальное разрешение
  source_height   Int?
  source_type     String?    // camera_photo | screen_shot | video_frame
  osd_text        String?    // OCR распознанный текст OSD
  quality_score   Float?     // 0.0-1.0
  tier            String?    // A | B | C | D (quality tier)
  profile         String?    // modern_1080p | color_lowres | ir_screen_photo
  processed_at    DateTime?
  status          String     @default("pending") // pending | processing | completed
  created_at      DateTime   @default(now())
  
  episode         Episode    @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  faces           ArchiveFace[]
  
  @@index([episode_id])
  @@index([processed_at])
}

/// Архивное лицо (детектированное на архивном фото)
model ArchiveFace {
  id                    Int        @id @default(autoincrement())
  photo_id              Int
  episode_person_id     Int?
  cluster_id            Int?
  bbox_x                Float
  bbox_y                Float
  bbox_w                Float
  bbox_h                Float
  det_score             Float?
  kps                   String?    // JSON array of 5 points
  pitch_deg             Float?     // угол наклона вверх/вниз
  yaw_deg               Float?     // угол поворота влево/вправо
  blur_score            Float?     // 0.0-1.0, ниже = размыто
  brightness            Float?     // средняя яркость
  occlusion             Float?     // 0.0-1.0, выше = больше окклюзия
  quality_score         Float?     // 0.0-1.0综合 оценка качества
  tier                  String?    // A | B | C | D
  embedding             String?    // JSON array of floats
  embedding_model       String?    // buffalo_l | adaface
  status                String     @default("detected") // detected | embedding_extracted | manual_review | rejected
  reject_reason         String?
  created_at            DateTime   @default(now())
  processed_at          DateTime?
  
  photo                 ArchivePhoto @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  episode_person        EpisodePerson? @relation(fields: [episode_person_id], references: [id], onDelete: SetNull)
  cluster               FaceCluster? @relation(fields: [cluster_id], references: [id], onDelete: SetNull)
  
  @@index([photo_id])
  @@index([episode_person_id])
  @@index([cluster_id])
  @@index([tier])
  @@index([status])
}

/// Кластер лиц внутри эпизода (предполагаемый один человек)
model FaceCluster {
  id                      Int        @id @default(autoincrement())
  episode_id              Int
  cluster_id              String     // UUID как строка
  face_count              Int        @default(1)
  avg_quality             Float?
  representative_photo_id Int?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @default(now())
  
  episode                 Episode    @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  faces                   ArchiveFace[]
  
  @@index([episode_id, cluster_id])
  @@unique([episode_id, cluster_id])
}

/// Журнал кластеризации для аудита
model ClusteringLog {
  id              Int        @id @default(autoincrement())
  episode_id      Int
  cluster_id      String
  action          String     // created | merged | split | labeled | propagated
  person_id       Int?
  from_cluster_id String?
  to_cluster_id   String?
  confidence      Float?
  updated_by      String?    // operator ID or "auto"
  timestamp       DateTime   @default(now())
  
  episode         Episode    @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  
  @@index([episode_id, cluster_id])
  @@index([timestamp])
}

/// Настройка профиля обработки для разных источников
model ProcessingProfile {
  name              String     @id
  description       String
  detector          String     @default("scrfd") // scrfd | retinaface | yolo
  recognizer        String     @default("arcface") // arcface | adaface
  min_face_size     Int        @default(60)
  min_det_score     Float      @default(0.5)
  pose_pitch_max    Float      @default(35.0)   // для потолочных камер можно 40+
  pose_yaw_max      Float      @default(35.0)
  quality_tier_a    Float      @default(0.7)    // порог для тира A
  quality_tier_b    Float      @default(0.4)    // порог для тира B
  similarity_intra  Float      @default(0.55)   // порог склейки внутри эпизода
  similarity_cross  Float      @default(0.45)   // порог склейки между камерами
  use_multitemplate Boolean    @default(true)
  use_bw_twin       Boolean    @default(true)   // генерировать ч/б-близнецы для цветных фото
  created_at        DateTime   @default(now())
  updated_at        DateTime   @default(now())
}

model Settings {
  key   String @id
  value String
}

model FaissUpdateLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  action      String
  details     String?
  status      String
}
